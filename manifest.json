{
  "manifest_version": 3,
  "name": "Shiori",
  "short_name": "Shiori",
  "version": "0.2.0",
  "description": "Personal manga tracker: pins series, follows your reading, checks releases, syncs to your own WebDAV (OpenCloud). Imports MangaPin exports.",
  "permissions": ["storage", "unlimitedStorage", "alarms", "tabs", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background.js",
    "scripts": ["src/background.js"],
    "type": "module"
  },
  "action": {
    "default_title": "Shiori",
    "default_popup": "src/popup/popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" }
  },
  "options_ui": { "page": "src/app/app.html", "open_in_tab": true },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "minimum_chrome_version": "120",
  "browser_specific_settings": {
    "gecko": { "id": "shiori@local", "strict_min_version": "128.0" }
  }
}
